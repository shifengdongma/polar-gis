POSTGRES_DB=polar_gis
POSTGRES_USER=polar_gis
POSTGRES_PASSWORD=replace-with-a-strong-password
APP_SECRET_KEY=replace-with-a-long-random-secret
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-immediately
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=replace-with-a-strong-password
PUBLIC_PORT=8088

# S-57 Basemap Import (optional)
S57_BASEMAP_SOURCE_ROOT=/data/s57-basemaps
S57_BASEMAP_PROFILE=global_overview_v1
S57_BASEMAP_ALLOW_LOCAL_SOURCE=false

# Ice overlay (optional)
# 冰情功能总开关;数据目录在容器内固定为 /data/ice
ICE_ENABLED=true
# 宿主机数据目录(相对 deploy/ 目录;默认仓库内 data/ice)
# 本地验证真实数据时可指向样例目录,例如: ../sample-data
ICE_DATA_HOST_PATH=../data/ice

# Navigation / planning (optional)
NAVIGATION_ENABLED=true
# 宿主机导航数据目录(水深/风/浪/流;海冰默认复用 ICE_DATA_HOST_PATH)
NAVIGATION_DATA_HOST_PATH=../data/navigation
# 合成研究 E2E 时可改为 /data/navigation/ice + nextsim
NAVIGATION_ICE_DATA_ROOT=/data/ice
NAVIGATION_ICE_BACKEND=auto
NAVIGATION_DEFAULT_DATA_POLICY=real_only
PLANNER_RESULT_ROOT=/data/storage/navigation/plans
PLANNER_MAX_CELLS=20000
PLANNER_MAX_CANDIDATES=20
PLANNER_MAX_GENERATIONS=100
PLANNER_POPULATION_SIZE=36
PLANNER_TIMEOUT_SECONDS=300
PLANNER_MAX_CONCURRENT_JOBS=1
PLANNER_MAX_QUEUED_RUNS=10
PLANNER_MAX_RETAINED_RUNS=100

