APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://polar_gis:polar_gis@localhost:5432/polar_gis
AUTO_CREATE_SCHEMA=false
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
STORAGE_ROOT=storage
TEMP_ROOT=storage/temp
MAX_UPLOAD_BYTES=5368709120
GEOSERVER_URL=http://localhost:8080/geoserver
GEOSERVER_PUBLIC_URL=/geoserver
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=replace-me
GEOSERVER_WORKSPACE=polar_gis
GDAL_OGRINFO_COMMAND=ogrinfo
GDAL_OGR2OGR_COMMAND=ogr2ogr
GDAL_INFO_COMMAND=gdalinfo
DEMO_DATA_ENABLED=true
# 冰情叠加(只读 NetCDF → PNG XYZ 瓦片)
ICE_ENABLED=true
ICE_DATA_ROOT=/data/ice
ICE_TILE_CACHE_ENTRIES=256
ICE_TILE_MAX_ZOOM=10
# 导航环境/规划(全部有默认值;本地开发显式设置数据根,禁止依赖 /data 绝对路径)
NAVIGATION_ENABLED=true
NAVIGATION_DATA_ROOT=/data/navigation
# 缺省复用 ICE_DATA_ROOT;nextsim 合成研究数据可指向 NAVIGATION_DATA_ROOT/ice
# NAVIGATION_ICE_DATA_ROOT=/data/ice
NAVIGATION_ICE_BACKEND=auto
# 缺省为 NAVIGATION_DATA_ROOT/navigation_manifest.json
# NAVIGATION_MANIFEST_PATH=/data/navigation/navigation_manifest.json
NAVIGATION_DEFAULT_DATA_POLICY=real_only
NAVIGATION_ALLOW_FUTURE_MATCH=false
NAVIGATION_MAX_LAG_WIND_HOURS=6
NAVIGATION_MAX_LAG_ICE_HOURS=24
NAVIGATION_MAX_LAG_CURRENT_HOURS=24
NAVIGATION_MAX_LAG_WAVE_HOURS=24
NAVIGATION_TILE_CACHE_ENTRIES=128
NAVIGATION_TILE_MAX_ZOOM=8
NAVIGATION_MAX_BATCH_POINTS=500
NAVIGATION_FIELD_MAX_POINTS=900
PLANNER_MAX_CELLS=20000
PLANNER_MAX_CANDIDATES=20
PLANNER_MAX_GENERATIONS=100
PLANNER_POPULATION_SIZE=36
PLANNER_TIMEOUT_SECONDS=300
PLANNER_MAX_CONCURRENT_JOBS=1
PLANNER_MAX_QUEUED_RUNS=10
PLANNER_MAX_RETAINED_RUNS=100
PLANNER_RESULT_ROOT=storage/navigation/plans
PLANNER_RISK_GRID_MAX_CELLS=20000
PLANNER_MAX_ROUTE_POINTS=1000
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-me-now
